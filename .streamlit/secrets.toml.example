# Copy this file to `.streamlit/secrets.toml` (which is git-ignored) and set a
# password to enable the optional login gate in app.py.
#
# On Streamlit Community Cloud, paste the same key/value under
# "App settings → Secrets" instead of committing a file.

# Optional password protection. Leave unset/empty to keep the app open.
APP_PASSWORD = "change-me"
